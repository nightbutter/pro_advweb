{
  "name": "rider-routing-backend",
  "version": "1.0.0",
  "description": "Backend API for Smart Rider Route Planning",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node-dev --transpile-only server.ts",
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:data": "tsx scripts/migrate-data.ts",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "check:db": "tsx scripts/check-connection.ts",
    "check:target": "tsx scripts/verify-target.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "9.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^17.6.0-beta.15",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
