# Set these in Vercel → Project Settings → Environment Variables.
# JWT_SECRET, ADMIN_PASSWORD and RIDER_PASSWORD are REQUIRED in production
# (the server refuses to start without them). Locally, dev defaults are used.

# Long random string used to sign login tokens, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Initial passwords, used only when the users table is first created
ADMIN_PASSWORD=
RIDER_PASSWORD=

# Comma-separated frontend URLs allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:4200

# Neon PostgreSQL (see https://neon.tech -> your project -> Connection Details)
# Copy this file to server/.env and fill in the real values — never commit .env.
# Pooled connection (endpoint host contains "-pooler") used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Direct (unpooled) connection used by migration / data-transfer scripts.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Optional: port for local development (default 3000)
# PORT=3000
